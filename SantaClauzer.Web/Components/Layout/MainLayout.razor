@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SantaClauzer.Web.Services
@using Microsoft.AspNetCore.Components.Routing
@inject NotificationState NotificationState
@inject NavigationManager NavigationManager

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>Hello @context.User.Identity?.Name!</Authorized>
                <NotAuthorized>You are not logged in</NotAuthorized>
            </AuthorizeView>
            <a href="/logout">Log out</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<!-- interactive host component renders inside layout and handles toast UI -->
<ToastHost />

@code {
    // layout no longer needs to be interactive; toast handling lives in ToastHost
}
