@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using SantaClauzer.Model.Models
@using SantaClauzer.Web.Authentication
@using SantaClauzer.Web.Components.Layout
@using SantaClauzer.Web.Services
@inject ApiClient ApiClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject NotificationState NotificationState
@rendermode InteractiveServer

<div class="p-5">
    <EditForm Model="loginModel" FormName="Login" OnValidSubmit="HandleLogin">
        <DataAnnotationsValidator />
        <div class="form-group">
            <label for="Username">Username</label>
            <InputText id="Username" class="form-control" @bind-Value="loginModel.Username" />
        </div>
        <div class="form-group">
            <label for="Password">Password</label>
            <InputText id="Password" type="password" class="form-control" @bind-Value="loginModel.Password" />
        </div>
        <button type="submit" class="btn btn-primary mt-3">Login</button>
    </EditForm>
</div>

@code {
    private LoginModel loginModel = new LoginModel();

    private async Task HandleLogin()
    {
        var result = await ApiClient.PostAsync<LoginResponseModel, LoginModel>("api/auth/login", loginModel);
        if (result != null && result.Token != null)
        {
            await ((CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result);
            NotificationState.SetSuccess("Login successful.");
            Navigation.NavigateTo("/");
        }
        else
        {
            NotificationState.SetError("Login failed. Check your credentials.");
        }
    }
}

