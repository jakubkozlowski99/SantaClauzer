@page "/present-groups/mine"
@using Microsoft.AspNetCore.Authorization
@using SantaClauzer.Web.Components.BaseComponents.PresentGroup
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, User")]

<h3>My Present Groups</h3>

@if (PresentGroupModels == null)
{
    <p>Loading...</p>
}
else
{
    <!-- hide the create button for this page -->
    <PresentGroupList Groups="PresentGroupModels" OnDeleteRequested="HandleDeleteRequested" ShowCreateButton="false" />
}

<AppModal @ref="AppModal">
    <Title>Notification</Title>
    <Body>
        Are you sure you want to delete this present group?
    </Body>
    <Footer>
        <button type="button" class="btn btn-primary" style="width:80px" @onclick="HandleDelete">Yes</button>
        <button type="button" class="btn btn-secondary" data-dismiss="modal" @onclick="() => AppModal.CloseModal()">Cancel</button>
    </Footer>
</AppModal>