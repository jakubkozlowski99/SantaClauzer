@page "/present-groups/details/{Id:int}"
@using SantaClauzer.Model.Entities
@using SantaClauzer.Model.Models
@using SantaClauzer.Web.Services

<h3>Present Group Details</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (notFound)
{
    <div class="alert alert-warning">Present group not found.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h4 class="card-title">@Model.Name</h4>
            <p class="card-text">@Model.Description</p>

            <dl class="row">
                <dt class="col-sm-3">Creator</dt>
                <dd class="col-sm-9">
                    @if (Model.Creator != null)
                    {
                        <text>@Model.Creator.UserName</text>
                    }
                    else
                    {
                        <em>Unknown</em>
                    }
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("g")</dd>

                <dt class="col-sm-3">Budget</dt>
                <dd class="col-sm-9">@Model.Budget</dd>

                <dt class="col-sm-3">Wish List Items</dt>
                <dd class="col-sm-9">
                    @if (Model.WishLists is null || !Model.WishLists.Any())
                    {
                        <em>No wishes</em>
                    }
                    else
                    {
                        <ul>
                            @foreach (var w in Model.WishLists)
                            {
                                <li>@w.Content</li>
                            }
                        </ul>
                    }
                </dd>

                <dt class="col-sm-3">Members</dt>
                <dd class="col-sm-9">
                    @if (members is null || !members.Any())
                    {
                        <em>No members</em>
                    }
                    else
                    {
                        <ul>
                            @foreach (var m in members)
                            {
                                <li>@(m.UserName)</li>
                            }
                        </ul>
                    }
                </dd>
            </dl>

            <button class="btn btn-secondary" @onclick="@(() => NavigationManager.NavigateTo("/present-groups"))">Back</button>
            <a class="btn btn-outline-primary ms-2" href="@($"/present-groups/update/{Id}")">Edit</a>

            @if (isCreator)
            {
                <button class="btn btn-danger ms-2" @onclick="ShowDeleteModal">Delete</button>
                <button class="btn btn-primary ms-2" @onclick="ShowInviteModal">Send Invite</button>
            }
        </div>
    </div>
}

<!-- Delete confirmation modal (same behavior as IndexPresentGroup) -->
<AppModal @ref="DeleteModal">
    <Title>Notification</Title>
    <Body>
        Are you sure you want to delete this present group?
    </Body>
    <Footer>
        <button type="button" class="btn btn-primary" style="width:80px" @onclick="ConfirmDelete">Yes</button>
        <button type="button" class="btn btn-secondary" @onclick="() => DeleteModal.CloseModal()">Cancel</button>
    </Footer>
</AppModal>

<!-- Invite modal -->
<AppModal @ref="InviteModal">
    <Title>Send Invite</Title>
    <Body>
        <div class="mb-3">
            <label for="inviteUsername" class="form-label">Username</label>
            <input id="inviteUsername" class="form-control" @bind="inviteUsername" />
        </div>
    </Body>
    <Footer>
        <button type="button" class="btn btn-primary" @onclick="SendInvite">Send</button>
        <button type="button" class="btn btn-secondary" @onclick="() => InviteModal.CloseModal()">Cancel</button>
    </Footer>
</AppModal>
